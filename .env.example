# =============================================================================
# ControlPlane.ai Enterprise AI Proxy Gateway — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your real values:
#
#   cp .env.example .env
#
# .env is git-ignored and never committed.
# .env.example is committed and kept up to date as the canonical reference.
#
# Every variable has a safe default that lets the gateway start and serve mock
# responses without any real credentials. Replace values section by section as
# you obtain real API keys.
#
# Key presence is detected at startup. Run GET /v1/config/health to see which
# integrations are active vs degraded at any time.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM Provider (direct-call fallback)
# -----------------------------------------------------------------------------
# Used when Portkey is not configured. Supports any OpenAI-compatible provider.
# Rename from OPENAI_API_KEY if you have an existing .env file.
#
# Providers:  openai | anthropic | google | grok | generic
# Leave LLM_API_KEY empty to use mock/contextual responses (safe for local dev).

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_FALLBACK_MODEL=gpt-4o-mini

# Provider-specific key examples (uncomment the one you need):
# LLM_API_KEY=sk-...                        # OpenAI
# LLM_API_KEY=sk-ant-...                    # Anthropic Claude
# LLM_API_KEY=AIza...                       # Google Gemini
# LLM_API_KEY=xai-...                       # Grok / xAI


# -----------------------------------------------------------------------------
# 2. Portkey Gateway (recommended for production)
# -----------------------------------------------------------------------------
# Portkey is the unified LLM routing layer. When configured, it handles
# automatic retries, fallback between SLM and Frontier tiers, cost tracking,
# and provider switching without code changes.
#
# Get your keys at: https://app.portkey.ai/
#
# PORTKEY_API_KEY:              Your Portkey workspace API key
# PORTKEY_SLM_VIRTUAL_KEY:      Virtual key pointing to your cheap/fast model
#                               (e.g. gpt-4o-mini, claude-haiku, gemini-flash)
# PORTKEY_FRONTIER_VIRTUAL_KEY: Virtual key pointing to your capable model
#                               (e.g. gpt-4o, claude-3-5-sonnet, gemini-pro)
#
# Leave as dummy-* to use mock responses locally.

PORTKEY_API_KEY=dummy-portkey-key
PORTKEY_SLM_VIRTUAL_KEY=slm-virtual-key
PORTKEY_FRONTIER_VIRTUAL_KEY=frontier-virtual-key


# -----------------------------------------------------------------------------
# 3. Langfuse Observability (optional)
# -----------------------------------------------------------------------------
# Enables cloud-based distributed tracing, prompt/response tracking, and
# performance analytics. Without these keys the gateway falls back to stdout
# logging — all functionality still works.
#
# Get your keys at: https://cloud.langfuse.com/ (or self-host)
#
# LANGFUSE_HOST: override for self-hosted deployments

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tuning (safe to leave at defaults)
LANGFUSE_BUFFER_SIZE=1000
LANGFUSE_RETRY_INTERVAL_S=30


# -----------------------------------------------------------------------------
# 4. Guardrails AI Output Validation (optional)
# -----------------------------------------------------------------------------
# Comma-separated list of Guardrails Hub validator IDs to load at startup.
# The gateway attempts to auto-install missing validators from the Hub.
# Validators that fail to load are skipped with a warning — the gateway
# continues serving with pass-through output validation.
#
# Browse validators at: https://hub.guardrailsai.com/
#
# GUARDRAILS_HUB_TOKEN: leave empty for public (free) validators.
#                       Set to your Hub token for private/premium validators.

GUARDRAILS_VALIDATORS=toxic-language,competitor-check
GUARDRAILS_HUB_TOKEN=


# -----------------------------------------------------------------------------
# 5. Worldsense MCP Server (optional — multi-turn agentic oversight)
# -----------------------------------------------------------------------------
# The Worldsense MCP server provides advanced multi-turn consequence-chain
# analysis. When unreachable, the gateway falls back automatically to the
# built-in heuristic evaluator (keyword + pattern matching) — no data loss.
#
# Run the MCP server locally:
#   cd mcp_servers/worldsense
#   pip install -r requirements.txt
#   python server.py
#
# WORLDSENSE_MCP_URL: full evaluate endpoint URL

WORLDSENSE_ENABLED=true
WORLDSENSE_MCP_URL=http://localhost:9100/evaluate
WORLDSENSE_TIMEOUT_MS=300


# -----------------------------------------------------------------------------
# 6. Redteam MCP Server (optional — automated adversarial testing)
# -----------------------------------------------------------------------------
# The Redteam MCP server runs adversarial attack suites against the gateway.
# Used by the PostFileSave hook when policy files are saved.
#
# Run the MCP server locally:
#   cd mcp_servers/redteam
#   pip install -r requirements.txt
#   python server.py
#
# Port is configured inside the server; leave URL pointing to localhost:9200.

REDTEAM_ENABLED=true
REDTEAM_MIN_PROMPTS=50
REDTEAM_SCHEDULE=


# -----------------------------------------------------------------------------
# 7. Semantic Cache (Phase 3)
# -----------------------------------------------------------------------------
# Vector-similarity cache that short-circuits repeated or semantically similar
# requests. Requires gptcache to be installed (pip install gptcache).
# When gptcache is absent the cache is a no-op — no configuration needed.
#
# CACHE_SIMILARITY_THRESHOLD: cosine similarity floor for a cache hit [0.0–1.0]
# Per-profile TTL and enable/disable are set in the policy YAML, not here.

CACHE_SIMILARITY_THRESHOLD=0.92


# -----------------------------------------------------------------------------
# 8. Policy & Pipeline Settings
# -----------------------------------------------------------------------------
# POLICY_FILE_PATH: path to a YAML/JSON policy file defining UseCaseProfiles.
#   Leave empty to use only the two built-in profiles:
#     customer_chatbot  — conservative defaults, PII masking on
#     internal_copilot  — relaxed thresholds, agentic oversight on
#
# EMBEDDING_MODEL: used by the Groundedness Auditor for document embeddings.
#   Any OpenAI-compatible embedding model name works when LLM_API_KEY is set.

POLICY_FILE_PATH=
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_TOP_K=5


# -----------------------------------------------------------------------------
# 9. Telemetry
# -----------------------------------------------------------------------------
# TELEMETRY_SINK: where structured request logs are written.
#   stdout — print to console (default, good for containers)
#   file   — write to TELEMETRY_LOG_FILE
#   <url>  — POST to a remote collector endpoint

TELEMETRY_SINK=stdout
TELEMETRY_LOG_FILE=telemetry.jsonl


# -----------------------------------------------------------------------------
# 10. Obot Agent Governance
# -----------------------------------------------------------------------------
# Controls tool-call limits for agentic requests (Req. 11).
# Max tool calls per request before ESCALATE_TO_HUMAN is triggered.

OBOT_ENABLED=true
OBOT_MAX_TOOL_CALLS_DEFAULT=10
OBOT_LATENCY_BUDGET_MS=20
